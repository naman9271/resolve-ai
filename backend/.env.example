# Resolve AI Backend Environment Variables
# Copy this file to .env and fill in the values

# App Settings
APP_NAME=Resolve AI
DEBUG=True

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./app/db/resolve_ai.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/resolve_ai

# JWT Settings (Generate a secure key for production!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Supabase Storage (Optional - for Resource Hub)
SUPABASE_URL=
SUPABASE_KEY=
